<?xml version="1.0" encoding="UTF-8"?>
<!--
 Petstore Lite: Tomcat binding for java:comp/env/jdbc/CatalogDB.
 Replaces the J2EE RI data source for the Cloudscape EstoreDB.
-->
<Context path="/petstore">
  <Resource name="jdbc/CatalogDB"
            auth="Container"
            type="javax.sql.DataSource"
            driverClassName="org.apache.derby.jdbc.EmbeddedDriver"
            url="jdbc:derby:/var/petstore/db/PetStoreDB;create=true"
            username="estoreuser"
            password=«REDACTED:secret-finding-18»
            maxTotal="20"
            maxIdle="5"
            maxWaitMillis="10000"/>
</Context>

<?xml version="1.0" encoding="UTF-8"?>
<!--
 Petstore Lite batch schedule, Control-M Workload Automation export.
 Two folders:
   PSL_PETSTORE_DAILY   nightly chain: backup -> audit extract -> report / purge,
                        plus the 06:00 catalog check
   PSL_PETSTORE_CYCLIC  account unlock every 15 minutes, all day
 Scripts live in /opt/petstore/batch (batch/ in the source tree).
-->
<DEFTABLE xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="Folder.xsd">

  <FOLDER DATACENTER="DC_PSL_PRD" VERSION="919" PLATFORM="UNIX" FOLDER_NAME="PSL_PETSTORE_DAILY"
          FOLDER_ORDER_METHOD="SYSTEM" REAL_FOLDER_ID="1001" TYPE="1" USED_BY_CODE="0">

    <JOB JOBISN="1" APPLICATION="PETSTORE" SUB_APPLICATION="DATABASE" JOBNAME="PSL_DB_BACKUP"
         DESCRIPTION="Online backup of PetStoreDB, keep 7 days"
         TASKTYPE="Job" MEMLIB="/opt/petstore/batch" MEMNAME="psl_db_backup.sh"
         RUN_AS="tomcat" NODEID="psl-app01" PRIORITY="AA" CRITICAL="1"
         TIMEFROM="0100" WEEKDAYS="ALL" DAYSCAL="PSL_CAL" MAXRERUN="2" INTERVAL="00010M"
         CREATED_BY="psl_ops" CREATION_DATE="20031014" CHANGE_DATE="20260915">
      <OUTCOND NAME="PSL_DB_BACKUP-OK" ODATE="ODAT" SIGN="+" />
      <ON STMT="*" CODE="NOTOK">
        <DOMAIL URGENCY="U" DEST="psl-ops@example.invalid" SUBJECT="PSL_DB_BACKUP failed" MESSAGE="Petstore DB backup failed, audit extract is held" />
      </ON>
    </JOB>

    <JOB JOBISN="2" APPLICATION="PETSTORE" SUB_APPLICATION="SECURITY" JOBNAME="PSL_AUDIT_EXTRACT"
         DESCRIPTION="Export yesterday SIGNON_AUDIT rows to signon_audit_YYYYMMDD.csv"
         TASKTYPE="Job" MEMLIB="/opt/petstore/batch" MEMNAME="psl_audit_extract.sh"
         RUN_AS="tomcat" NODEID="psl-app01" PRIORITY="AB"
         TIMEFROM="0130" WEEKDAYS="ALL" MAXRERUN="1"
         CREATED_BY="psl_ops" CREATION_DATE="20031014" CHANGE_DATE="20260915">
      <INCOND NAME="PSL_DB_BACKUP-OK" ODATE="ODAT" AND_OR="A" />
      <OUTCOND NAME="PSL_DB_BACKUP-OK" ODATE="ODAT" SIGN="-" />
      <OUTCOND NAME="PSL_AUDIT_EXTRACT-OK" ODATE="ODAT" SIGN="+" />
      <ON STMT="*" CODE="NOTOK">
        <DOMAIL URGENCY="R" DEST="psl-security@example.invalid" SUBJECT="PSL_AUDIT_EXTRACT failed" MESSAGE="Sign-on audit extract not produced" />
      </ON>
    </JOB>

    <JOB JOBISN="3" APPLICATION="PETSTORE" SUB_APPLICATION="SECURITY" JOBNAME="PSL_SIGNON_REPORT"
         DESCRIPTION="Daily sign-on statistics report"
         TASKTYPE="Command" CMDLINE="/opt/petstore/batch/psl_signon_report.sh"
         RUN_AS="tomcat" NODEID="psl-app01" PRIORITY="AC"
         TIMEFROM="0145" WEEKDAYS="ALL"
         CREATED_BY="psl_ops" CREATION_DATE="20031014" CHANGE_DATE="20260915">
      <INCOND NAME="PSL_AUDIT_EXTRACT-OK" ODATE="ODAT" AND_OR="A" />
      <OUTCOND NAME="PSL_SIGNON_REPORT-OK" ODATE="ODAT" SIGN="+" />
    </JOB>

    <JOB JOBISN="4" APPLICATION="PETSTORE" SUB_APPLICATION="SECURITY" JOBNAME="PSL_AUDIT_PURGE"
         DESCRIPTION="Delete SIGNON_AUDIT rows older than 90 days (Sundays)"
         TASKTYPE="Job" MEMLIB="/opt/petstore/batch" MEMNAME="psl_audit_purge.sh"
         RUN_AS="tomcat" NODEID="psl-app01" PRIORITY="AD"
         TIMEFROM="0200" WEEKDAYS="0"
         CREATED_BY="psl_ops" CREATION_DATE="20031014" CHANGE_DATE="20260915">
      <INCOND NAME="PSL_AUDIT_EXTRACT-OK" ODATE="ODAT" AND_OR="A" />
      <OUTCOND NAME="PSL_AUDIT_EXTRACT-OK" ODATE="ODAT" SIGN="-" />
      <OUTCOND NAME="PSL_AUDIT_PURGE-OK" ODATE="ODAT" SIGN="+" />
    </JOB>

    <JOB JOBISN="5" APPLICATION="PETSTORE" SUB_APPLICATION="CATALOG" JOBNAME="PSL_CATALOG_CHECK"
         DESCRIPTION="Catalog integrity check before the store opens; first load when empty"
         TASKTYPE="Command" CMDLINE="/opt/petstore/batch/psl_catalog_check.sh"
         RUN_AS="tomcat" NODEID="psl-app01" PRIORITY="AA" CRITICAL="1"
         TIMEFROM="0600" WEEKDAYS="ALL"
         CREATED_BY="psl_ops" CREATION_DATE="20031014" CHANGE_DATE="20260915">
      <OUTCOND NAME="PSL_CATALOG_CHECK-OK" ODATE="ODAT" SIGN="+" />
      <ON STMT="*" CODE="COMPSTAT=4">
        <DOMAIL URGENCY="U" DEST="psl-catalog@example.invalid" SUBJECT="Petstore catalog integrity check failed" MESSAGE="See /var/petstore/log/catalog_check.log" />
      </ON>
    </JOB>
  </FOLDER>

  <FOLDER DATACENTER="DC_PSL_PRD" VERSION="919" PLATFORM="UNIX" FOLDER_NAME="PSL_PETSTORE_CYCLIC"
          FOLDER_ORDER_METHOD="SYSTEM" REAL_FOLDER_ID="1002" TYPE="1" USED_BY_CODE="0">

    <JOB JOBISN="1" APPLICATION="PETSTORE" SUB_APPLICATION="SECURITY" JOBNAME="PSL_ACCT_UNLOCK"
         DESCRIPTION="Unlock sign-on accounts locked for more than 30 minutes"
         TASKTYPE="Job" MEMLIB="/opt/petstore/batch" MEMNAME="psl_acct_unlock.sh"
         RUN_AS="tomcat" NODEID="psl-app01" PRIORITY="AA"
         TIMEFROM="0000" TIMETO="2359" WEEKDAYS="ALL"
         CYCLIC="1" CYCLIC_TYPE="Interval" INTERVAL="00015M" IND_CYCLIC="START"
         CREATED_BY="psl_ops" CREATION_DATE="20031014" CHANGE_DATE="20260915">
    </JOB>
  </FOLDER>

</DEFTABLE>
